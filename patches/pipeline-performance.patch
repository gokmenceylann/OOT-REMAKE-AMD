diff --git a/gpu/vk/pipeline_cache_file.h b/gpu/vk/pipeline_cache_file.h
index 5e61f404..cd65de36 100644
--- a/gpu/vk/pipeline_cache_file.h
+++ b/gpu/vk/pipeline_cache_file.h
@@ -264,7 +264,17 @@ public:
     }
     static PipelineCacheFile writable(const std::string& path, size_t capacity) {
         PipelineCacheFile result;
-        if (!capacity || capacity > (uint64_t)INT64_MAX || !result.create_temporary(path)) return {};
+        if (!capacity || capacity > (uint64_t)INT64_MAX) return {};
+#if defined(_WIN32)
+        // The destination stays in place until publication, so the temporary needs its full size in free space.
+        const auto filename = wide(path);
+        if (filename.empty()) return {};
+        const auto parent = std::filesystem::path(filename).parent_path();
+        ULARGE_INTEGER available{};
+        if (GetDiskFreeSpaceExW(parent.empty() ? L"." : parent.c_str(), &available, nullptr, nullptr) &&
+            capacity > available.QuadPart) return {};
+#endif
+        if (!result.create_temporary(path)) return {};
         result.size_ = capacity;
         if (!result.resize(capacity)) return {};
 #if !defined(_WIN32)
