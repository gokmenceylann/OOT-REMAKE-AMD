+static uint64_t target_block_size(uint32_t memory_type) {
+    // Keep the explicit tuning override and all other adapters' defaults.
+    if (getenv("RX_VK_IMAGE_BLOCK_MB") || getenv("RX_VK_TARGET_BLOCK_MB"))
+        return getenv("RX_VK_TARGET_BLOCK_MB")
+            ? (uint64_t)std::clamp(atoi(getenv("RX_VK_TARGET_BLOCK_MB")), 16, 512) << 20
+            : kImageBlock;
+    if (dev.props.vendorID != 0x1002 || dev.props.deviceType != VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU ||
+        !dev.memory_budget) return kImageBlock;
+    const uint32_t heap = dev.memory.memoryTypes[memory_type].heapIndex;
+    VmaBudget budgets[VK_MAX_MEMORY_HEAPS]{};
+    vmaGetHeapBudgets(vma, budgets);
+    const auto cap = budgets[heap].budget;
+    return cap && cap <= (9ull << 30) ? 64ull << 20 : kImageBlock;
+}
