+namespace {
+struct ResourceCounter {
+    const char* label;
+    std::atomic<uint64_t> bytes{0};
+    std::atomic<uint64_t> allocations{0};
+};
+ResourceCounter sampled{"sampled"}, targets{"render-target"}, depth{"depth"},
+                images{"other-image"}, buffers{"buffer"};
+
+
+void track(VmaAllocation allocation, ResourceCounter& kind) {
+    kind.bytes.fetch_add(allocation_size(allocation), std::memory_order_relaxed);
+    kind.allocations.fetch_add(1, std::memory_order_relaxed);
+    vmaSetAllocationUserData(vma, allocation, &kind);
+}
+void untrack(VmaAllocation allocation) {
+    if (!allocation) return;
+    VmaAllocationInfo info{};
+    vmaGetAllocationInfo(vma, allocation, &info);
+    if (auto* kind = static_cast<ResourceCounter*>(info.pUserData)) {
+        kind->bytes.fetch_sub(info.size, std::memory_order_relaxed);
+        kind->allocations.fetch_sub(1, std::memory_order_relaxed);
+    }
+}
+}
