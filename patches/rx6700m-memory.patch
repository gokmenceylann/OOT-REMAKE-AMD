+std::atomic<unsigned> allocation_failures{0};
+
+static void allocation_failure(const char* kind, VkResult result, uint64_t bytes,
+                               uint32_t usage, const VkImageCreateInfo* image = nullptr) {
+    const unsigned count = ++allocation_failures;
+    if (count > 8 && count % 120 != 0) return;
+    VmaBudget budgets[VK_MAX_MEMORY_HEAPS]{};
+    vmaGetHeapBudgets(vma, budgets);
+    logf("vk: allocation failure #%u: %s VkResult=%d bytes=%llu usage=%#x %ux%ux%u format=%d",
+         count, kind, int(result), (unsigned long long)bytes, usage,
+         image ? image->extent.width : 0, image ? image->extent.height : 0,
+         image ? image->extent.depth : 0, image ? int(image->format) : 0);
+    for (uint32_t heap = 0; heap < dev.memory.memoryHeapCount; ++heap) {
+        const auto& b = budgets[heap];
+        logf("vk: heap %u %s: budget=%llu usage=%llu blocks=%llu live=%llu bytes (%s)",
+             heap, (dev.memory.memoryHeaps[heap].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) ? "device" : "system",
+             (unsigned long long)b.budget, (unsigned long long)b.usage,
+             (unsigned long long)b.statistics.blockBytes, (unsigned long long)b.statistics.allocationBytes,
+             dev.memory_budget ? "driver budget" : "VMA estimate");
+    }
+}
