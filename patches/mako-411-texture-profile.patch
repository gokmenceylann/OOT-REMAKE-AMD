+
+// Samples one call in 16 per bucket and reports only the calling replay thread.
+enum TextureDetail { TD_VIEW, TD_PREPARE, TD_SAMPLER, TD_HAZARD, TD_COUNT };
+const bool texture_detail_on = env_on("RX_VK_TEXTURE_PROFILE");
+struct TextureDetailStats {
+    uint64_t calls = 0, samples = 0;
+    int64_t ns = 0;
+};
+thread_local std::array<TextureDetailStats, TD_COUNT> texture_detail;
+struct TextureDetailScope {
+    TextureDetailStats* stats = nullptr;
+    int64_t start = 0;
+    explicit TextureDetailScope(TextureDetail detail) {
+        if (!texture_detail_on) return;
+        auto& bucket = texture_detail[detail];
+        if ((bucket.calls++ & 15) != 0) return;
+        stats = &bucket;
+        start = prof_now();
+    }
+    ~TextureDetailScope() {
+        if (!stats) return;
+        stats->ns += prof_now() - start;
+        ++stats->samples;
+    }
+};
+void texture_detail_report(double frames) {
+    if (!texture_detail_on || frames <= 0) return;
+    static constexpr const char* names[] = {"view inclusive", "texture preparation within view",
+                                             "sampler", "hazards+pass"};
+    for (int i = 0; i < TD_COUNT; ++i) {
+        auto& b = texture_detail[i];
+        const double mean = b.samples ? (double)b.ns / (double)b.samples : 0;
+        logf("vk: texture CPU sample: %s %.3f ms/frame, %llu calls, %llu samples",
+             names[i], mean * (double)b.calls / frames / 1e6, (unsigned long long)b.calls, (unsigned long long)b.samples);
+        b = {};
+    }
 }
 
