+// Capture mode: a key is emitted once per replay thread per 60-frame window. The exporter
+// combines windows and region markers; no shared lock or disk file is added to ordinary draws.
+static void region_use(bool compute, uint64_t key, uint64_t variant = 0) {
+    const uint64_t window = texture_frame_no() / 60;
+    static thread_local uint64_t last_window = ~0ull;
+    static thread_local std::unordered_set<uint64_t> graphics;
+    static thread_local std::unordered_map<uint64_t, std::unordered_set<uint64_t>> computes;
+    if (last_window != window) {
+        graphics.clear();
+        computes.clear();
+        last_window = window;
+    }
+    if (compute) {
+        if (computes[key].insert(variant).second)
+            logf("vk: region pipeline use c %016llx %016llx", (unsigned long long)key, (unsigned long long)variant);
+    } else if (graphics.insert(key).second) {
+        logf("vk: region pipeline use g %016llx", (unsigned long long)key);
+    }
+}
