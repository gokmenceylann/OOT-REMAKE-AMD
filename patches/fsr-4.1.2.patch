+// The SDK receives this proc table only for the upscale context. Observe its synchronous
+// creation calls without changing their results or logging from the steady-state dispatch.
+struct CreateTrace {
+    VkResult error = VK_SUCCESS;
+    const char* operation = nullptr;
+    uint32_t calls = 0;
+    bool verbose = false;
+    uint32_t images = 0, buffers = 0, descriptors = 0, pipelines = 0, allocations = 0;
+    uint64_t bytes = 0;
+};
+thread_local CreateTrace* active_create_trace = nullptr;
+
+template<auto function, auto tuned = nullptr> struct ObservedVulkanCall;
+template<class... Args, VkResult (VKAPI_PTR **function)(Args...), auto tuned>
+struct ObservedVulkanCall<function, tuned> {
+    static VKAPI_ATTR VkResult VKAPI_CALL invoke(Args... args) {
+        auto call = *function;
+        if constexpr (tuned != nullptr) {
+            if (tune::on()) call = tuned;
+        }
+        const VkResult result = call(args...);
+        if (auto* trace = active_create_trace) {
+            ++trace->calls;
+            record(*trace, result, args...);
+        }
+        return result;
+    }
+
+    template<class Info, class Output>
+    static void record(CreateTrace& t, VkResult result, VkDevice, const Info* info,
+                       const VkAllocationCallbacks*, Output*) {
+        const char* name = nullptr;
+        if constexpr (std::is_same_v<Info, VkImageCreateInfo>) {
+            name = "vkCreateImage";
+            ++t.images;
+            if (t.verbose) logf("vk: AMD FSR 4: %s %ux%ux%u format=%d mips=%u layers=%u usage=%#x VkResult=%d",
+                 name, info->extent.width, info->extent.height, info->extent.depth, (int)info->format,
+                 info->mipLevels, info->arrayLayers, info->usage, (int)result);
+        } else if constexpr (std::is_same_v<Info, VkBufferCreateInfo>) {
+            name = "vkCreateBuffer";
+            ++t.buffers;
+            if (t.verbose) logf("vk: AMD FSR 4: %s size=%llu usage=%#x VkResult=%d", name,
+                 (unsigned long long)info->size, info->usage, (int)result);
+        } else if constexpr (std::is_same_v<Info, VkMemoryAllocateInfo>) {
+            name = "vkAllocateMemory";
+            ++t.allocations;
+            t.bytes += info->allocationSize;
+            if (t.verbose) logf("vk: AMD FSR 4: %s size=%llu type=%u VkResult=%d", name,
+                 (unsigned long long)info->allocationSize, info->memoryTypeIndex, (int)result);
+        } else if constexpr (std::is_same_v<Info, VkDescriptorPoolCreateInfo>) {
+            name = "vkCreateDescriptorPool";
+            for (uint32_t i = 0; i < info->poolSizeCount; ++i) t.descriptors += info->pPoolSizes[i].descriptorCount;
+            if (t.verbose) logf("vk: AMD FSR 4: %s maxSets=%u poolTypes=%u VkResult=%d", name,
+                 info->maxSets, info->poolSizeCount, (int)result);
+        } else if constexpr (std::is_same_v<Info, VkDescriptorSetLayoutCreateInfo>) {
+            name = "vkCreateDescriptorSetLayout";
+            if (t.verbose) logf("vk: AMD FSR 4: %s bindings=%u VkResult=%d", name, info->bindingCount, (int)result);
+        } else if constexpr (std::is_same_v<Info, VkPipelineLayoutCreateInfo>) {
+            name = "vkCreatePipelineLayout";
+        } else if constexpr (std::is_same_v<Info, VkShaderModuleCreateInfo>) {
+            name = "vkCreateShaderModule";
+            if (t.verbose) logf("vk: AMD FSR 4: %s codeBytes=%llu VkResult=%d", name,
+                 (unsigned long long)info->codeSize, (int)result);
+        } else if constexpr (std::is_same_v<Info, VkImageViewCreateInfo>) {
+            name = "vkCreateImageView";
+        }
+        failure(t, result, name);
+    }
+
+    static void record(CreateTrace& t, VkResult result, VkDevice, VkPipelineCache, uint32_t count,
+                       const VkComputePipelineCreateInfo*, const VkAllocationCallbacks*, VkPipeline*) {
+        t.pipelines += count;
+        if (t.verbose) logf("vk: AMD FSR 4: vkCreateComputePipelines count=%u VkResult=%d", count, (int)result);
+        failure(t, result, "vkCreateComputePipelines");
+    }
+    static void record(CreateTrace& t, VkResult result, VkDevice, const VkDescriptorSetAllocateInfo* info, VkDescriptorSet*) {
+        if (t.verbose) logf("vk: AMD FSR 4: vkAllocateDescriptorSets count=%u VkResult=%d", info->descriptorSetCount, (int)result);
+        failure(t, result, "vkAllocateDescriptorSets");
+    }
+    static void record(CreateTrace& t, VkResult result, VkDevice, VkImage, VkDeviceMemory, VkDeviceSize) {
+        failure(t, result, "vkBindImageMemory");
+    }
+    static void record(CreateTrace& t, VkResult result, VkDevice, VkBuffer, VkDeviceMemory, VkDeviceSize) {
+        failure(t, result, "vkBindBufferMemory");
+    }
+    static void failure(CreateTrace& t, VkResult result, const char* name) {
+        if (result >= 0 || t.operation) return;
+        t.error = result;
+        t.operation = name;
+    }
+};
