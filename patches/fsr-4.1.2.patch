+/// A conservative discontinuity test: most of the current frustum no longer
+/// maps near the previous viewport, at both a mid and a distant depth.
+inline bool camera_cut(const float reprojection[16], const float jitter[2]) {
+    unsigned outside = 0;
+    for (float z : {0.95f, 0.995f}) {
+        for (float y : {-0.65f, 0.0f, 0.65f}) {
+            for (float x : {-0.65f, 0.0f, 0.65f}) {
+                const float cx = x + jitter[0], cy = y + jitter[1];
+                const auto project = [&](int row) {
+                    const float* m = reprojection + 4 * row;
+                    return m[0] * cx + m[1] * cy + m[2] * z + m[3];
+                };
+                const float w = project(3);
+                if (w <= 1e-6f || std::fabs(project(0)) > 1.2f * w || std::fabs(project(1)) > 1.2f * w)
+                    ++outside;
+            }
+        }
+    }
+    return outside >= 15;
+}
