+#define OBSERVE(fn) if (fn && std::strcmp(name, #fn) == 0) return reinterpret_cast<PFN_vkVoidFunction>(&ObservedVulkanCall<&fn>::invoke)
+    OBSERVE(vkCreateImage);
+    OBSERVE(vkCreateImageView);
+    OBSERVE(vkCreateBuffer);
+    OBSERVE(vkAllocateMemory);
+    OBSERVE(vkCreateDescriptorPool);
+    OBSERVE(vkCreateDescriptorSetLayout);
+    OBSERVE(vkAllocateDescriptorSets);
+    OBSERVE(vkCreatePipelineLayout);
+    OBSERVE(vkCreateShaderModule);
+    OBSERVE(vkCreateComputePipelines);
+    OBSERVE(vkBindImageMemory);
+    OBSERVE(vkBindBufferMemory);
+#undef OBSERVE
+    return original;
