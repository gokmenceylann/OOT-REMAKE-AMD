+namespace mkwvk {
+
+// Discrete capacity comes from device-local heaps. UMA capacity is shared RAM.
+constexpr int recommended_preset(bool discrete, uint64_t capacity, uint64_t budget) {
+    constexpr uint64_t MiB = 1024 * 1024;
+    if (!discrete || !capacity) return 1;
+    const uint64_t usable = budget && budget < capacity ? budget : capacity;
+    if (usable < 5 * 1024 * MiB) return 1;
+    if (usable < 7 * 1024 * MiB) return 2;
+    if (usable < 10 * 1024 * MiB) return 3;
+    if (usable < 14 * 1024 * MiB) return 4;
+    return 5;
+}
