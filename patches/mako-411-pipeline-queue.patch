@@ -10,11 +10,22 @@
 #include <cstdlib>
 #include <cstring>
 #include <mutex>
+#include <new>
 #include <thread>
 #include <vector>
 
 using namespace mkwvk;
 
+static thread_local bool count_allocations = false;
+static thread_local unsigned allocations = 0;
+void* operator new(std::size_t size) {
+    if (count_allocations) ++allocations;
+    if (void* ptr = std::malloc(size ? size : 1)) return ptr;
+    throw std::bad_alloc();
+}
+void operator delete(void* ptr) noexcept { std::free(ptr); }
+void operator delete(void* ptr, std::size_t) noexcept { std::free(ptr); }
+
 namespace {
 
 int failures = 0;
@@ -129,6 +140,17 @@ void hurry() {
     jobs_push([&] { a_at = order++; a_done.store(true); jobs_notify(); }, false, &a_done);
     jobs_push([&] { b_runs++; b_on = std::this_thread::get_id(); b_at = order++; b_done.store(true); jobs_notify(); }, false, &b_done);
     expect(jobs_hurry(b_done), "the queued job is found");
+    // Keep the worker busy while moving the last item repeatedly. On a deque,
+    // the old erase + push_front path must eventually allocate another block.
+    constexpr unsigned count = 256;
+    std::vector<std::atomic<bool>> done(count);
+    for (auto& flag : done) jobs_push([&flag] { flag.store(true); }, false, &flag);
+    bool all_found = true;
+    count_allocations = true;
+    for (unsigned i = count; i > 0; --i) all_found &= jobs_hurry(done[i - 1]);
+    count_allocations = false;
+    expect(all_found, "all queued completion flags survive promotion");
+    expect(allocations == 0, "promoting an existing job allocates no memory");
     std::atomic<bool> never{false};
     expect(!jobs_hurry(never), "a flag with no queued job is not found");
     release();
