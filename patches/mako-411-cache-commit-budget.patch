+bool pipeline_cache_import_allowed(const std::string& path, size_t bytes) {
+#ifdef _WIN32
+    MEMORYSTATUSEX status{};
+    status.dwLength = sizeof status;
+    const bool measured = GlobalMemoryStatusEx(&status) && status.ullTotalPageFile &&
+                          status.ullAvailPageFile <= status.ullTotalPageFile;
+    if (!measured || !pipeline_cache_fits_commit(bytes, status.ullAvailPageFile)) {
+        logf("vk: pipeline cache retained on disk: %zu bytes, available commit %llu bytes (measurement valid=%d): %s",
+             bytes, (unsigned long long)status.ullAvailPageFile, (int)measured, path.c_str());
+        return false;
+    }
+#else
+    (void)path;
+    (void)bytes;
+#endif
+    return true;
+}
